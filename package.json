{
  "name": "zero-kagaku",
  "version": "0.4.0",
  "private": true,
  "description": "ゼロからの科学 〜石と水と木から〜 自然資源から現代科学までを再建する科学シミュレーションゲーム",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/engine.test.mjs && node tests/nature.test.mjs && node tests/sim.mjs",
    "e2e": "npm run build && node tests/e2e/play.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "npx --yes http-server dist -p 8080 -c-1"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0"
  }
}
